# Valid defaults
DATABASE_URL=sqlite://data/lmah.db

LMAH_COOKIE_KEY="" # cargo run --bin generate-cookie-key
LMAH_EXTERNAL_URL=""
LMAH_AUTHORIZED_USERS="" # email@example.com,email2@example.com

# To override
LMAH_GOOGLE_OAUTH_KEY="changeme"
LMAH_GOOGLE_OAUTH_SECRET="changeme"
LMAH_GOOGLE_CREDENTIALS='{"type":"service_account"}' # JSON of a service API key
LMAH_GOOGLE_BUCKET_NAME="lmah-app-files-qa"

LMAH_PDF_ROCKET_API_KEY=""